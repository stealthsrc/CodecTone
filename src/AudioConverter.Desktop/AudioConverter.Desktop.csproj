<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AudioConverter.Core\AudioConverter.Core.csproj" />
    <ProjectReference Include="..\AudioConverter.Infrastructure\AudioConverter.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\assets\audio-converter.ico</ApplicationIcon>
    <AssemblyName>CodecTone</AssemblyName>
    <RootNamespace>AudioConverter.Desktop</RootNamespace>
    <Version>1.2.0</Version>
    <Product>CodecTone</Product>
    <Company>Stealthy Labs</Company>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\audio-converter-logo.png" Link="Assets\audio-converter-logo.png" />
  </ItemGroup>

</Project>
