<Window x:Class="AudioConverter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AudioConverter.Desktop.Controls"
        xmlns:converters="clr-namespace:AudioConverter.Desktop.Converters"
        mc:Ignorable="d" Title="CodecTone" Width="1180" Height="820" MinWidth="900" MinHeight="650"
        Icon="Assets/audio-converter-logo.png" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:TimestampValueConverter x:Key="TimestampConverter" />
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30,24,30,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image Source="Assets/audio-converter-logo.png" Width="38" Height="38" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1"><TextBlock Text="CodecTone" FontSize="29" FontWeight="Bold" /><TextBlock Text="Local audio tools for Windows." Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" /></StackPanel>
            <Button Grid.Column="2" Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" MinWidth="105" Margin="0,2,14,2" />
            <Border Grid.Column="3" Background="{DynamicResource AccentMutedBrush}" Padding="15,9" CornerRadius="3" VerticalAlignment="Center"><TextBlock Text="LOCAL · NO TELEMETRY" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" /></Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="30,0,30,14">
            <Button Content="CONVERT" Command="{Binding ShowConvertCommand}" Tag="{Binding ConvertTabState}" Style="{StaticResource TabButton}" Margin="0,0,10,0" />
            <Button Content="CUT AUDIO" Command="{Binding ShowCutCommand}" Tag="{Binding CutTabState}" Style="{StaticResource TabButton}" Margin="0,0,10,0" />
            <Button Content="COMPRESS AUDIO" Command="{Binding ShowCompressCommand}" Tag="{Binding CompressionTabState}" Style="{StaticResource TabButton}" MinWidth="155" />
            <Button Content="ABOUT" Command="{Binding ShowAboutCommand}" Tag="{Binding AboutTabState}" Style="{StaticResource TabButton}" MinWidth="110" Margin="10,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Margin="20,0,20,0">
            <Grid Margin="10,0,10,20">
                <Border Visibility="{Binding IsConvertPage, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Source" FontWeight="Bold" Margin="0,0,0,10" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" MinHeight="39" />
                            <Button Grid.Column="1" Content="Choose file" Command="{Binding ChooseFileCommand}" MinWidth="120" Margin="10,0,0,0" />
                            <Button Grid.Column="2" Content="Choose folder" Command="{Binding ChooseFolderCommand}" MinWidth="130" Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock Text="Drop one supported audio file or a folder anywhere in this window." Foreground="{DynamicResource MutedTextBrush}" Margin="2,9,0,20" />
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20" />

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="190" /><ColumnDefinition Width="190" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Convert to" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" Visibility="{Binding IsLossyFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Audio quality" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Bitrate}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="14,0,0,0" Visibility="{Binding IsLosslessFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Sample rate" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="14,0,0,0" Visibility="{Binding IsLosslessFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Bit depth" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding BitDepths}" SelectedItem="{Binding BitDepth}" /></StackPanel>
                        </Grid>
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,22" />

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseOutputCommand}" MinWidth="120" Margin="10,23,16,0" />
                            <StackPanel Grid.Column="2"><TextBlock Text="File suffix · optional" Margin="0,0,0,7" /><TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </Grid>
                        <TextBlock Text="Leave blank to create a 'converted' folder beside each source." Foreground="{DynamicResource MutedTextBrush}" Margin="2,8,0,16" />
                        <Grid><CheckBox Content="Keep title, artist, album and cover art" IsChecked="{Binding PreserveMetadata}" /><CheckBox Content="Overwrite existing files" IsChecked="{Binding Overwrite}" HorizontalAlignment="Right" /></Grid>
                        <TextBlock Text="Tags and embedded cover art are copied when the destination supports them." Foreground="{DynamicResource MutedTextBrush}" Margin="2,5,0,20" />
                        <TextBlock Text="Conversion report" FontWeight="Bold" Margin="0,0,0,8" /><TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding IsCutPage, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Source file" FontWeight="Bold" Margin="0,0,0,10" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding CutSourcePath}" IsReadOnly="True" /><Button Grid.Column="1" Content="Choose file" Command="{Binding ChooseCutFileCommand}" MinWidth="130" Margin="10,0,0,0" /></Grid>
                        <TextBlock Text="Drop one supported audio file here or choose it manually." Foreground="{DynamicResource MutedTextBrush}" Margin="2,9,0,20" />
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20" />
                        <TextBlock Text="Selection timeline" FontWeight="Bold" Margin="0,0,0,10" />
                        <controls:WaveformControl Peaks="{Binding WaveformPeaks}" Duration="{Binding DurationSeconds}" Start="{Binding StartSeconds}" End="{Binding EndSeconds}" Height="300" />
                        <TextBlock Text="Drag either handle on the waveform, or type exact timestamps below." Foreground="{DynamicResource MutedTextBrush}" Margin="2,9,0,18" />

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Start" Margin="0,0,0,7" /><TextBox Text="{Binding StartSeconds, Converter={StaticResource TimestampConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="End" Margin="0,0,0,7" /><TextBox Text="{Binding EndSeconds, Converter={StaticResource TimestampConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Selection duration" Margin="0,0,0,7" /><TextBlock Text="{Binding SelectionDuration, Converter={StaticResource TimestampConverter}}" FontWeight="Bold" Padding="10,9" /></StackPanel>
                        </Grid>
                        <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><CheckBox Content="Fade in" IsChecked="{Binding FadeInEnabled}" /><TextBox Text="{Binding FadeInSeconds}" Margin="0,6,0,0" /></StackPanel>
                            <StackPanel Grid.Column="1"><CheckBox Content="Fade out" IsChecked="{Binding FadeOutEnabled}" /><TextBox Text="{Binding FadeOutSeconds}" Margin="0,6,0,0" /></StackPanel>
                        </Grid>
                        <TextBlock Text="Fade duration in seconds." Foreground="{DynamicResource MutedTextBrush}" Margin="2,7,0,18" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Output format" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding CutFormat}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="File suffix" Margin="0,0,0,7" /><TextBox Text="{Binding CutSuffix}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="14,0,0,0"><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding CutOutputFolder}" /></StackPanel>
                            <Button Grid.Column="3" Content="Browse" Command="{Binding ChooseCutOutputCommand}" MinWidth="120" Margin="10,23,0,0" />
                        </Grid>
                        <Grid Margin="0,17,0,20"><CheckBox Content="Keep metadata and cover art" IsChecked="{Binding PreserveMetadata}" /><CheckBox Content="Overwrite existing file" IsChecked="{Binding Overwrite}" HorizontalAlignment="Right" /></Grid>
                        <TextBlock Text="Cut report" FontWeight="Bold" Margin="0,0,0,8" /><TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding IsCompressionPage, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Compression source" FontWeight="Bold" Margin="0,0,0,10" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CompressionSourcePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Choose file" Command="{Binding ChooseCompressionFileCommand}" MinWidth="120" Margin="10,0,0,0" />
                            <Button Grid.Column="2" Content="Choose folder" Command="{Binding ChooseCompressionFolderCommand}" MinWidth="130" Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock Text="Drop one audio file or a folder. Folders are scanned recursively." Foreground="{DynamicResource MutedTextBrush}" Margin="2,9,0,20" />
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20" />

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="230" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Compress to" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding CompressionFormats}" SelectedItem="{Binding CompressionFormat}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Compression profile" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding CompressionProfiles}" SelectedItem="{Binding SelectedCompressionProfile}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="14,0,0,0" Visibility="{Binding IsTargetSizeCompression, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Target total size · MiB" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionTargetTotalMb}" /></StackPanel>
                            <Button Grid.Column="3" Content="ANALYZE" Command="{Binding AnalyzeCompressionCommand}" MinWidth="120" Margin="14,23,0,0" />
                        </Grid>
                        <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,18,0,20"><TextBlock Text="{Binding CompressionEstimate}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" /></Border>

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionOutputFolder}" /></StackPanel>
                            <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseCompressionOutputCommand}" MinWidth="120" Margin="10,23,16,0" />
                            <StackPanel Grid.Column="2"><TextBlock Text="File suffix · optional" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionSuffix}" /></StackPanel>
                        </Grid>
                        <TextBlock Text="Leave blank to create a 'compressed' folder and preserve the source tree." Foreground="{DynamicResource MutedTextBrush}" Margin="2,8,0,15" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <CheckBox Content="Keep metadata and cover art" IsChecked="{Binding CompressionPreserveMetadata}" />
                            <CheckBox Grid.Column="1" Content="Optimize large cover art · max 1200 px" IsChecked="{Binding CompressionOptimizeArtwork}" />
                            <CheckBox Grid.Column="2" Content="Overwrite existing files" IsChecked="{Binding CompressionOverwrite}" />
                        </Grid>
                        <TextBlock Text="Lossy-to-lossy compression will display a confirmation because it can reduce quality." Foreground="{DynamicResource MutedTextBrush}" Margin="2,7,0,20" />
                        <TextBlock Text="Compression report" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBox Text="{Binding CompressionReport, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding IsAboutPage, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="36">
                    <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Image Source="Assets/audio-converter-logo.png" Width="56" Height="56" Margin="0,0,20,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CodecTone" FontSize="38" FontWeight="Bold" />
                                <TextBlock Text="Local audio tools for Windows" FontSize="17" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="VERSION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ProductVersion}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="76,20,0,0">
                            <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,8,0"><TextBlock Text="LOCAL PROCESSING" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" /></Border>
                            <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,8,0"><TextBlock Text="NO TELEMETRY" FontSize="11" FontWeight="Bold" /></Border>
                            <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10,6"><TextBlock Text="WINDOWS" FontSize="11" FontWeight="Bold" /></Border>
                        </WrapPanel>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,30" />
                        <TextBlock Text="WHAT CODECTONE DOES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,28,0"><TextBlock Text="Convert" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Move between MP3, FLAC, WAV, OGG, AAC and M4A with explicit quality controls." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" /></StackPanel>
                            <StackPanel Margin="0,0,28,0"><TextBlock Text="Cut" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Select an exact waveform range, add fades and preview the result before export." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" /></StackPanel>
                            <StackPanel><TextBlock Text="Compress" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Reduce file size with quality profiles, target budgets and recursive folder processing." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" /></StackPanel>
                        </UniformGrid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,30" />
                        <TextBlock Text="HOW IT WORKS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16" />
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,22,0"><TextBlock Text="01" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" /><TextBlock Text="Select" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="Choose or drop a file or folder." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            <StackPanel Margin="0,0,22,0"><TextBlock Text="02" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" /><TextBlock Text="Validate" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="ffprobe checks streams and metadata." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            <StackPanel Margin="0,0,22,0"><TextBlock Text="03" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" /><TextBlock Text="Process" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="FFmpeg works locally on your PC." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="04" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" /><TextBlock Text="Write" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="CodecTone saves the result you chose." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                        </UniformGrid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,30" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="PRIVACY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="Your media stays on this computer. CodecTone has no cloud storage, analytics or telemetry. Network access occurs only when you request FFmpeg installation or open GitHub." TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="BUILT WITH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text=".NET 8 · WPF · FFmpeg" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="Created by Stealthy Labs · MIT License" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0" /></StackPanel>
                        </Grid>

                        <Button Content="VIEW ON GITHUB" Command="{Binding OpenGitHubCommand}" HorizontalAlignment="Left" MinWidth="165" Margin="0,30,0,0" AutomationProperties.Name="Open the Stealthy Labs GitHub profile" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Visibility="{Binding IsToolWorkspace, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="30,14,30,18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TimingText}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" /><Button Content="INSTALL FFMPEG" Command="{Binding InstallFfmpegCommand}" Visibility="{Binding FfmpegMissing, Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Left" Margin="0,9,0,0" /></StackPanel>
                    <Button Grid.Column="1" Content="PREVIEW CUT" Command="{Binding PreviewCommand}" Visibility="{Binding IsCutPage, Converter={StaticResource BooleanToVisibility}}" MinWidth="130" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Content="STOP" Command="{Binding StopPreviewCommand}" Visibility="{Binding IsCutPage, Converter={StaticResource BooleanToVisibility}}" MinWidth="100" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Content="CONVERT AUDIO" Command="{Binding ConvertCommand}" Visibility="{Binding IsConvertPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="170" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Content="CUT AUDIO" Command="{Binding CutCommand}" Visibility="{Binding IsCutPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Content="COMPRESS AUDIO" Command="{Binding CompressCommand}" Visibility="{Binding IsCompressionPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="180" Margin="10,0,0,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
