<Window x:Class="AudioConverter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AudioConverter.Desktop.Controls"
        xmlns:converters="clr-namespace:AudioConverter.Desktop.Converters"
        mc:Ignorable="d" Title="CodecTone" Width="1180" Height="820" MinWidth="900" MinHeight="650"
        Icon="Assets/audio-converter-logo.png" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:TimestampValueConverter x:Key="TimestampConverter" />
        <Style x:Key="RemixPresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="20,12" /><Setter Property="MinHeight" Value="44" /><Setter Property="MinWidth" Value="125" /><Setter Property="Margin" Value="0,0,8,8" /></Style>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30,24,30,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image Source="Assets/audio-converter-logo.png" Width="38" Height="38" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1"><TextBlock Text="CodecTone" FontSize="29" FontWeight="Bold" /><TextBlock Text="Local audio tools for Windows." Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" /></StackPanel>
            <Button Grid.Column="2" Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" MinWidth="105" Margin="0,2,14,2" />
            <Border Grid.Column="3" Background="{DynamicResource AccentMutedBrush}" Padding="15,9" CornerRadius="3" VerticalAlignment="Center"><TextBlock Text="LOCAL · NO TELEMETRY" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" /></Border>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="30,0,30,14">
            <Button Content="CONVERT" Command="{Binding ShowConvertCommand}" Tag="{Binding ConvertTabState}" Style="{StaticResource TabButton}" Margin="0,0,10,0" />
            <Button Content="CUT AUDIO" Command="{Binding ShowCutCommand}" Tag="{Binding CutTabState}" Style="{StaticResource TabButton}" Margin="0,0,10,0" />
            <Button Content="COMPRESS AUDIO" Command="{Binding ShowCompressCommand}" Tag="{Binding CompressionTabState}" Style="{StaticResource TabButton}" MinWidth="155" />
            <Button Content="EXTRACT ARTWORK" Command="{Binding ShowArtworkCommand}" Tag="{Binding ArtworkTabState}" Style="{StaticResource TabButton}" MinWidth="165" Margin="10,0,0,0" />
            <Button Content="REMIX AUDIO" Command="{Binding ShowRemixCommand}" Tag="{Binding RemixTabState}" Style="{StaticResource TabButton}" MinWidth="140" Margin="10,0,0,0" />
            <Button Content="ABOUT" Command="{Binding ShowAboutCommand}" Tag="{Binding AboutTabState}" Style="{StaticResource TabButton}" MinWidth="110" Margin="10,0,0,0" />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" IsEnabled="{Binding IsWorkspaceEnabled}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Margin="20,0,20,0">
            <Grid Margin="10,0,10,20">
                <Border Visibility="{Binding IsConvertPage, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Source" FontWeight="Bold" Margin="0,0,0,10" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" MinHeight="39" />
                            <Button Grid.Column="1" Content="Choose file" Command="{Binding ChooseFileCommand}" MinWidth="120" Margin="10,0,0,0" />
                            <Button Grid.Column="2" Content="Choose folder" Command="{Binding ChooseFolderCommand}" MinWidth="130" Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock Text="Drop one supported audio file or a folder anywhere in this window." Foreground="{DynamicResource MutedTextBrush}" Margin="2,9,0,20" />
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20" />

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="190" /><ColumnDefinition Width="190" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Convert to" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" Visibility="{Binding IsLossyFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Audio quality" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Bitrate}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="14,0,0,0" Visibility="{Binding IsLosslessFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Sample rate" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SampleRate}" /></StackPanel>
                            <StackPanel Grid.Column="3" Margin="14,0,0,0" Visibility="{Binding IsLosslessFormat, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Bit depth" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding BitDepths}" SelectedItem="{Binding BitDepth}" /></StackPanel>
                        </Grid>
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,22" />

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseOutputCommand}" MinWidth="120" Margin="10,23,16,0" />
                            <StackPanel Grid.Column="2"><TextBlock Text="File suffix · optional" Margin="0,0,0,7" /><TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </Grid>
                        <TextBlock Text="Leave blank to create a 'converted' folder beside each source." Foreground="{DynamicResource MutedTextBrush}" Margin="2,8,0,16" />
                        <Grid><CheckBox Content="Keep title, artist, album and cover art" IsChecked="{Binding PreserveMetadata}" /><CheckBox Content="Overwrite existing files" IsChecked="{Binding Overwrite}" HorizontalAlignment="Right" /></Grid>
                        <TextBlock Text="Tags and embedded cover art are copied when the destination supports them." Foreground="{DynamicResource MutedTextBrush}" Margin="2,5,0,20" />
                        <TextBlock Text="Conversion report" FontWeight="Bold" Margin="0,0,0,8" /><TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding IsCutPage, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Source file" FontWeight="Bold" Margin="0,0,0,10" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding CutSourcePath}" IsReadOnly="True" /><Button Grid.Column="1" Content="Choose file" Command="{Binding ChooseCutFileCommand}" MinWidth="130" Margin="10,0,0,0" /></Grid>
                        <TextBlock Text="Drop one supported audio file here or choose it manually." Foreground="{DynamicResource MutedTextBrush}" Margin="2,9,0,20" />
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20" />
                        <TextBlock Text="Selection timeline" FontWeight="Bold" Margin="0,0,0,10" />
                        <controls:WaveformControl Peaks="{Binding WaveformPeaks}" Duration="{Binding DurationSeconds}" Start="{Binding StartSeconds}" End="{Binding EndSeconds}" Height="300" />
                        <TextBlock Text="Drag either handle on the waveform, or type exact timestamps below." Foreground="{DynamicResource MutedTextBrush}" Margin="2,9,0,18" />

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="Start" Margin="0,0,0,7" /><TextBox Text="{Binding StartSeconds, Converter={StaticResource TimestampConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="End" Margin="0,0,0,7" /><TextBox Text="{Binding EndSeconds, Converter={StaticResource TimestampConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Selection duration" Margin="0,0,0,7" /><TextBlock Text="{Binding SelectionDuration, Converter={StaticResource TimestampConverter}}" FontWeight="Bold" Padding="10,9" /></StackPanel>
                        </Grid>
                        <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0"><CheckBox Content="Fade in" IsChecked="{Binding FadeInEnabled}" /><TextBox Text="{Binding FadeInSeconds}" Margin="0,6,0,0" /></StackPanel>
                            <StackPanel Grid.Column="1"><CheckBox Content="Fade out" IsChecked="{Binding FadeOutEnabled}" /><TextBox Text="{Binding FadeOutSeconds}" Margin="0,6,0,0" /></StackPanel>
                        </Grid>
                        <TextBlock Text="Fade duration in seconds." Foreground="{DynamicResource MutedTextBrush}" Margin="2,7,0,18" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Output format" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding CutFormat}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="File suffix" Margin="0,0,0,7" /><TextBox Text="{Binding CutSuffix}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="14,0,0,0"><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding CutOutputFolder}" /></StackPanel>
                            <Button Grid.Column="3" Content="Browse" Command="{Binding ChooseCutOutputCommand}" MinWidth="120" Margin="10,23,0,0" />
                        </Grid>
                        <Grid Margin="0,17,0,20"><CheckBox Content="Keep metadata and cover art" IsChecked="{Binding PreserveMetadata}" /><CheckBox Content="Overwrite existing file" IsChecked="{Binding Overwrite}" HorizontalAlignment="Right" /></Grid>
                        <TextBlock Text="Cut report" FontWeight="Bold" Margin="0,0,0,8" /><TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding IsCompressionPage, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Compression source" FontWeight="Bold" Margin="0,0,0,10" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CompressionSourcePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Choose file" Command="{Binding ChooseCompressionFileCommand}" MinWidth="120" Margin="10,0,0,0" />
                            <Button Grid.Column="2" Content="Choose folder" Command="{Binding ChooseCompressionFolderCommand}" MinWidth="130" Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock Text="Drop one audio file or a folder. Folders are scanned recursively." Foreground="{DynamicResource MutedTextBrush}" Margin="2,9,0,20" />
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20" />

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="230" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Compress to" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding CompressionFormats}" SelectedItem="{Binding CompressionFormat}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Compression profile" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding CompressionProfiles}" SelectedItem="{Binding SelectedCompressionProfile}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="14,0,0,0" Visibility="{Binding IsTargetSizeCompression, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Target total size · MiB" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionTargetTotalMb}" /></StackPanel>
                            <Button Grid.Column="3" Content="ANALYZE" Command="{Binding AnalyzeCompressionCommand}" MinWidth="120" Margin="14,23,0,0" />
                        </Grid>
                        <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,18,0,20"><TextBlock Text="{Binding CompressionEstimate}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" /></Border>

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionOutputFolder}" /></StackPanel>
                            <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseCompressionOutputCommand}" MinWidth="120" Margin="10,23,16,0" />
                            <StackPanel Grid.Column="2"><TextBlock Text="File suffix · optional" Margin="0,0,0,7" /><TextBox Text="{Binding CompressionSuffix}" /></StackPanel>
                        </Grid>
                        <TextBlock Text="Leave blank to create a 'compressed' folder and preserve the source tree." Foreground="{DynamicResource MutedTextBrush}" Margin="2,8,0,15" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <CheckBox Content="Keep metadata and cover art" IsChecked="{Binding CompressionPreserveMetadata}" />
                            <CheckBox Grid.Column="1" Content="Optimize large cover art · max 1200 px" IsChecked="{Binding CompressionOptimizeArtwork}" />
                            <CheckBox Grid.Column="2" Content="Overwrite existing files" IsChecked="{Binding CompressionOverwrite}" />
                        </Grid>
                        <TextBlock Text="Lossy-to-lossy compression will display a confirmation because it can reduce quality." Foreground="{DynamicResource MutedTextBrush}" Margin="2,7,0,20" />
                        <TextBlock Text="Compression report" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBox Text="{Binding CompressionReport, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding IsArtworkPage, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Artwork source" FontWeight="Bold" Margin="0,0,0,10" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ArtworkSourcePath}" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Choose file" Command="{Binding ChooseArtworkFileCommand}" MinWidth="120" Margin="10,0,0,0" />
                            <Button Grid.Column="2" Content="Choose folder" Command="{Binding ChooseArtworkFolderCommand}" MinWidth="130" Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock Text="Drop one audio file or a folder. Folders are scanned recursively and one front cover is kept per album." Foreground="{DynamicResource MutedTextBrush}" Margin="2,9,0,20" TextWrapping="Wrap" />
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20" />

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="240" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Save as" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding ArtworkOutputFormats}" SelectedItem="{Binding ArtworkOutputFormat}" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" IsEnabled="{Binding IsArtworkConversion}"><CheckBox Content="Limit maximum dimension" IsChecked="{Binding ArtworkLimitDimensions}" Margin="0,0,0,7" /><TextBox Text="{Binding ArtworkMaximumDimension}" /></StackPanel>
                            <StackPanel Grid.Column="2" Margin="14,0,0,0"><TextBlock Text="Dimension unit" Margin="0,0,0,7" /><TextBlock Text="pixels · 64–8192" Padding="10,9" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel>
                            <Button Grid.Column="3" Content="ANALYZE" Command="{Binding AnalyzeArtworkCommand}" MinWidth="120" Margin="14,23,0,0" />
                        </Grid>
                        <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,18,0,20"><TextBlock Text="{Binding ArtworkEstimate}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" /></Border>

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Output folder" Margin="0,0,0,7" /><TextBox Text="{Binding ArtworkOutputFolder}" /></StackPanel>
                            <Button Grid.Column="1" Content="Browse" Command="{Binding ChooseArtworkOutputCommand}" MinWidth="120" Margin="10,23,0,0" />
                        </Grid>
                        <TextBlock Text="Leave blank to create an 'artwork' folder beside the selected source. Existing identical images are skipped; different collisions receive _2, _3, and so on." Foreground="{DynamicResource MutedTextBrush}" Margin="2,8,0,20" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding ArtworkAlbums}" SelectedItem="{Binding SelectedArtworkAlbum}" DisplayMemberPath="OutputBaseName" Margin="0,0,0,10" />
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="PREVIEW COVER" Command="{Binding PreviewArtworkCommand}" Margin="0,0,8,0" />
                            <Button Content="OPEN OUTPUT FOLDER" Command="{Binding OpenArtworkFolderCommand}" />
                        </WrapPanel>
                        <Image Source="{Binding ArtworkPreview}" Height="180" Stretch="Uniform" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding ArtworkPreviewInfo}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,18" />
                        <TextBlock Text="Artwork report" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBox Text="{Binding ArtworkReport, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding IsAboutPage, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="36">
                    <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Image Source="Assets/audio-converter-logo.png" Width="56" Height="56" Margin="0,0,20,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CodecTone" FontSize="38" FontWeight="Bold" />
                                <TextBlock Text="Local audio tools for Windows" FontSize="17" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="VERSION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ProductVersion}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="76,20,0,0">
                            <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,8,0"><TextBlock Text="LOCAL PROCESSING" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="Bold" /></Border>
                            <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,8,0"><TextBlock Text="NO TELEMETRY" FontSize="11" FontWeight="Bold" /></Border>
                            <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10,6"><TextBlock Text="WINDOWS" FontSize="11" FontWeight="Bold" /></Border>
                        </WrapPanel>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,30" />
                        <TextBlock Text="WHAT CODECTONE DOES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16" />
                        <UniformGrid Columns="5">
                            <StackPanel Margin="0,0,28,0"><TextBlock Text="Convert" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Move between MP3, FLAC, WAV, OGG, AAC and M4A with explicit quality controls." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" /></StackPanel>
                            <StackPanel Margin="0,0,28,0"><TextBlock Text="Cut" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Select an exact waveform range, add fades and preview the result before export." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" /></StackPanel>
                            <StackPanel Margin="0,0,28,0"><TextBlock Text="Compress" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Reduce file size with quality profiles, target budgets and recursive folder processing." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" /></StackPanel>
                            <StackPanel Margin="0,0,28,0"><TextBlock Text="Artwork" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Extract one embedded front cover per album in its original format or as PNG, JPEG or WebP." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" /></StackPanel>
                            <StackPanel><TextBlock Text="Remix" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Build an effect rack, preview twenty seconds, edit metadata and export one transformed song." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" /></StackPanel>
                        </UniformGrid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,30" />
                        <TextBlock Text="HOW IT WORKS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,16" />
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,22,0"><TextBlock Text="01" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" /><TextBlock Text="Select" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="Choose or drop a file or folder." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            <StackPanel Margin="0,0,22,0"><TextBlock Text="02" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" /><TextBlock Text="Validate" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="ffprobe checks streams and metadata." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            <StackPanel Margin="0,0,22,0"><TextBlock Text="03" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" /><TextBlock Text="Process" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="FFmpeg works locally on your PC." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="04" Foreground="{DynamicResource AccentBrush}" FontSize="20" FontWeight="Bold" /><TextBlock Text="Write" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="CodecTone saves the result you chose." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                        </UniformGrid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,30" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="PRIVACY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="Your media stays on this computer. CodecTone has no cloud storage, analytics or telemetry. Network access occurs only when you request FFmpeg installation or open GitHub." TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="BUILT WITH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text=".NET 8 · WPF · FFmpeg" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="Created by Stealthy Labs · MIT License" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0" /></StackPanel>
                        </Grid>

                        <TextBlock Text="Diagnostics are stored locally (about 1 MiB maximum). Reports may include file paths. Nothing is uploaded." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,20,0,8" />
                        <Button Content="OPEN LOCAL DIAGNOSTICS" Command="{Binding OpenDiagnosticsCommand}" HorizontalAlignment="Left" />
                        <Button Content="VIEW ON GITHUB" Command="{Binding OpenGitHubCommand}" HorizontalAlignment="Left" MinWidth="165" Margin="0,30,0,0" AutomationProperties.Name="Open the Stealthy Labs GitHub profile" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding IsRemixPage, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Remix source · one song" FontWeight="Bold" Margin="0,0,0,10" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RemixSourcePath}" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Choose file" Command="{Binding ChooseRemixFileCommand}" MinWidth="130" Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock Text="Drop one supported audio file here. Folder remixing is intentionally disabled." Foreground="{DynamicResource MutedTextBrush}" Margin="2,9,0,18" />

                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="PREVIEW ORIGINAL" Command="{Binding PreviewOriginalCommand}" Margin="0,0,10,0" />
                            <TextBlock Text="Preview volume · next playback" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding PreviewVolume}" Width="150" VerticalAlignment="Center" AutomationProperties.Name="Preview volume" />
                            <TextBlock Text="{Binding PreviewVolume, StringFormat={}{0:0}%}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Text="20-second preview selection" FontWeight="Bold" Margin="0,0,0,9" />
                        <controls:WaveformControl Peaks="{Binding RemixWaveformPeaks}" Duration="{Binding RemixDurationSeconds}" Start="{Binding RemixPreviewStartSeconds}" End="{Binding RemixPreviewEndSeconds}" Height="220" />
                        <Grid Margin="0,10,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Preview starts at" Foreground="{DynamicResource MutedTextBrush}" /><TextBox Text="{Binding RemixPreviewStartSeconds, Converter={StaticResource TimestampConverter}, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0" /></StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Estimated remix duration" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="{Binding RemixOutputDuration, Converter={StaticResource TimestampConverter}}" FontSize="16" FontWeight="SemiBold" Margin="0,11,0,0" /></StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="ADAPTIVE PRESETS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="Choose a category, then set the creative intensity." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" /></StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource AccentMutedBrush}" CornerRadius="3" Padding="12,7" Margin="12,0"><TextBlock Text="{Binding RemixAdaptiveLabel}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="11" /></Border>
                            <StackPanel Grid.Column="2"><TextBlock Text="Intensity" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" /><ComboBox ItemsSource="{Binding RemixIntensities}" SelectedItem="{Binding SelectedRemixIntensity}" Margin="0,5,0,0" /></StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="SPEED &amp; PITCH" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="SpeedPitch" Tag="{Binding SpeedPitchCategoryState}" Style="{StaticResource TabButton}" MinWidth="150" Margin="0,0,8,8" />
                            <Button Content="BASS &amp; PUNCH" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="BassPunch" Tag="{Binding BassPunchCategoryState}" Style="{StaticResource TabButton}" MinWidth="150" Margin="0,0,8,8" />
                            <Button Content="ATMOSPHERE" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="Atmosphere" Tag="{Binding AtmosphereCategoryState}" Style="{StaticResource TabButton}" MinWidth="150" Margin="0,0,8,8" />
                            <Button Content="VOCAL &amp; CLARITY" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="VocalClarity" Tag="{Binding VocalClarityCategoryState}" Style="{StaticResource TabButton}" MinWidth="150" Margin="0,0,8,8" />
                            <Button Content="COLOR &amp; TEXTURE" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="ColorTexture" Tag="{Binding ColorTextureCategoryState}" Style="{StaticResource TabButton}" MinWidth="150" Margin="0,0,8,8" />
                            <Button Content="MASTERING" Command="{Binding SelectRemixCategoryCommand}" CommandParameter="Mastering" Tag="{Binding MasteringCategoryState}" Style="{StaticResource TabButton}" MinWidth="150" Margin="0,0,8,8" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding FilteredRemixPresets}" Margin="0,0,0,2">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource RemixPresetButton}" Content="{Binding Name}" Command="{Binding DataContext.ApplyRemixPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="RESET / CUSTOM" Command="{Binding ResetRemixRackCommand}" HorizontalAlignment="Left" Padding="18,10" Margin="0,0,0,12" />
                        <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="13,10" Margin="0,0,0,18">
                            <StackPanel><TextBlock Text="{Binding RemixAnalysisStatus}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding RemixAdaptiveExplanation}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                        </Border>
                        <Border Visibility="{Binding IsExtremeAudioActive, Converter={StaticResource BooleanToVisibility}}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="3" Padding="13,10" Margin="0,0,0,18">
                            <StackPanel><TextBlock Text="HEARING WARNING" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" /><TextBlock Text="EARRAPE produces extreme distortion and loudness. Lower your headphones or speakers before Preview or Export. High-volume listening can permanently damage hearing." Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="22" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="EFFECT RACK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding RemixEffectKinds}" SelectedItem="{Binding SelectedRemixEffectKind}" />
                                    <Button Grid.Column="2" Content="ADD EFFECT" Command="{Binding AddRemixEffectCommand}" Margin="8,0,0,0" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding RemixEffects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PanelRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,9">
                                                <StackPanel>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Content="UP" Command="{Binding DataContext.MoveRemixEffectUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,5" Margin="4,0" />
                                                        <Button Grid.Column="2" Content="DOWN" Command="{Binding DataContext.MoveRemixEffectDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,5" Margin="0,0,4,0" />
                                                        <Button Grid.Column="3" Content="REMOVE" Command="{Binding DataContext.RemoveRemixEffectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,5" />
                                                    </Grid>
                                                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding FirstLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" /><TextBox Text="{Binding First, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0" Visibility="{Binding HasSecond, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{Binding SecondLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" /><TextBox Text="{Binding Second, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
                                                        <StackPanel Grid.Column="2" Visibility="{Binding HasThird, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="{Binding ThirdLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" /><TextBox Text="{Binding Third, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Add a preset or effect to begin. Normalize must follow gain effects; fades remain last." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,4,0,0" />
                            </StackPanel>

                            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Button Content="EXPORT" Command="{Binding ShowRemixInspectorCommand}" CommandParameter="Export" MinWidth="100" Margin="0,0,8,0" />
                                        <Button Content="METADATA" Command="{Binding ShowRemixInspectorCommand}" CommandParameter="Metadata" MinWidth="110" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsRemixExportTab, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="Output format" /><ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding RemixFormat}" Margin="0,6,0,12" />
                                        <StackPanel Visibility="{Binding IsRemixLossy, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Audio quality" /><ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding RemixBitrate}" Margin="0,6,0,12" /></StackPanel>
                                        <StackPanel Visibility="{Binding IsRemixLossless, Converter={StaticResource BooleanToVisibility}}"><TextBlock Text="Sample rate" /><ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding RemixSampleRateOption}" Margin="0,6,0,12" /><TextBlock Text="Bit depth" /><ComboBox ItemsSource="{Binding BitDepths}" SelectedItem="{Binding RemixBitDepth}" Margin="0,6,0,12" /></StackPanel>
                                        <TextBlock Text="Output folder" /><Grid Margin="0,6,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding RemixOutputFolder}" /><Button Grid.Column="1" Content="Browse" Command="{Binding ChooseRemixOutputCommand}" Margin="6,0,0,0" Padding="12,8" /></Grid>
                                        <TextBlock Text="File suffix" /><TextBox Text="{Binding RemixSuffix}" Margin="0,6,0,12" />
                                        <CheckBox Content="Overwrite existing file" IsChecked="{Binding RemixOverwrite}" />
                                        <TextBlock Text="Export report" FontWeight="SemiBold" Margin="0,16,0,6" /><TextBox Text="{Binding RemixReport, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding IsRemixMetadataTab, Converter={StaticResource BooleanToVisibility}}">
                                        <UniformGrid Columns="2"><StackPanel Margin="0,0,6,8"><TextBlock Text="Title" /><TextBox Text="{Binding RemixTitle}" Margin="0,4,0,0" /></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Text="Artist" /><TextBox Text="{Binding RemixArtist}" Margin="0,4,0,0" /></StackPanel></UniformGrid>
                                        <UniformGrid Columns="2"><StackPanel Margin="0,0,6,8"><TextBlock Text="Album" /><TextBox Text="{Binding RemixAlbum}" Margin="0,4,0,0" /></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Text="Album artist" /><TextBox Text="{Binding RemixAlbumArtist}" Margin="0,4,0,0" /></StackPanel></UniformGrid>
                                        <UniformGrid Columns="2"><StackPanel Margin="0,0,6,8"><TextBlock Text="Genre" /><TextBox Text="{Binding RemixGenre}" Margin="0,4,0,0" /></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Text="Date" /><TextBox Text="{Binding RemixDate}" Margin="0,4,0,0" /></StackPanel></UniformGrid>
                                        <UniformGrid Columns="2"><StackPanel Margin="0,0,6,8"><TextBlock Text="Track" /><TextBox Text="{Binding RemixTrack}" Margin="0,4,0,0" /></StackPanel><StackPanel Margin="6,0,0,8"><TextBlock Text="Disc" /><TextBox Text="{Binding RemixDisc}" Margin="0,4,0,0" /></StackPanel></UniformGrid>
                                        <TextBlock Text="Comment" /><TextBox Text="{Binding RemixComment}" AcceptsReturn="True" MinHeight="55" Margin="0,4,0,10" />
                                        <TextBlock Text="Cover art" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding RemixCoverActions}" SelectedItem="{Binding RemixCoverAction}" Margin="0,6,0,6" /><TextBox Text="{Binding RemixCoverPath}" IsReadOnly="True" Margin="0,0,0,6" /><StackPanel Orientation="Horizontal"><Button Content="REPLACE" Command="{Binding ChooseRemixCoverCommand}" Margin="0,0,6,0" /><Button Content="REMOVE" Command="{Binding RemoveRemixCoverCommand}" /></StackPanel>
                                        <Grid Margin="0,16,0,8"><TextBlock Text="CUSTOM TAGS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" /><Button Content="ADD TAG" Command="{Binding AddMetadataTagCommand}" HorizontalAlignment="Right" Padding="10,5" /></Grid>
                                        <ItemsControl ItemsSource="{Binding RemixCustomTags}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding Key}" Margin="0,0,5,0" /><TextBox Grid.Column="1" Text="{Binding Value}" Margin="0,0,5,0" /><Button Grid.Column="2" Content="×" Command="{Binding DataContext.RemoveMetadataTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="10,5" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Visibility="{Binding IsToolWorkspace, Converter={StaticResource BooleanToVisibility}}" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="30,14,30,18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="SAVE REPORT" Command="{Binding SaveReportCommand}" Margin="12,0,0,0" Padding="12,5" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TimingText}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" /><Button Content="INSTALL FFMPEG" Command="{Binding InstallFfmpegCommand}" Visibility="{Binding FfmpegMissing, Converter={StaticResource BooleanToVisibility}}" HorizontalAlignment="Left" Margin="0,9,0,0" /></StackPanel>
                    <Button Grid.Column="1" Content="PREVIEW CUT" Command="{Binding PreviewCommand}" Visibility="{Binding IsCutPage, Converter={StaticResource BooleanToVisibility}}" MinWidth="130" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Content="STOP" Command="{Binding StopPreviewCommand}" Visibility="{Binding IsCutPage, Converter={StaticResource BooleanToVisibility}}" MinWidth="100" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Content="CONVERT AUDIO" Command="{Binding ConvertCommand}" Visibility="{Binding IsConvertPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="170" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Content="CUT AUDIO" Command="{Binding CutCommand}" Visibility="{Binding IsCutPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Content="COMPRESS AUDIO" Command="{Binding CompressCommand}" Visibility="{Binding IsCompressionPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="180" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Content="EXTRACT ARTWORK" Command="{Binding ExtractArtworkCommand}" Visibility="{Binding IsArtworkPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="180" Margin="10,0,0,0" />
                    <Button Grid.Column="1" Content="PREVIEW REMIX" Command="{Binding PreviewRemixCommand}" Visibility="{Binding IsRemixPage, Converter={StaticResource BooleanToVisibility}}" MinWidth="130" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Content="STOP" Command="{Binding StopRemixCommand}" Visibility="{Binding IsRemixPage, Converter={StaticResource BooleanToVisibility}}" MinWidth="100" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Content="EXPORT REMIX" Command="{Binding ExportRemixCommand}" Visibility="{Binding IsRemixPage, Converter={StaticResource BooleanToVisibility}}" Style="{StaticResource PrimaryButton}" MinWidth="170" Margin="10,0,0,0" />
                    <Button Grid.Column="3" Content="CANCEL" Command="{Binding CancelOperationCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" MinWidth="120" Margin="10,0,0,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
